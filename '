#define MAX_USERS_SIZE 32
static char t_buff[MAX_MSG_SIZE];
static char r_buff[MAX_MSG_SIZE];
static User users[MAX_USERS_SIZE];
static size_t user_count = 0;
#define MAX_USERNAME_SIZE 32

static size_t trim_suffix(char *s, size_t l)
{
    if (l == 0) return 0;
    if (s[l-1] == '\n') {
        s[--l] = '\0';
    }
    if (l == 0) return 0;
    if (s[l-1] == '\r') {
        s[--l] = '\0';
    }
    return l;
}

static User *get_user_by_name(const char *name)
{
    for (User *u = users; u < &users[user_count]; u++) {
        if (strcmp(name, u->name) == 0) {
            return u;
        }
    }
    return NULL;
}

static void log_out(int client, User *user)
{
    if (user) {
        user->logged_in = false;
        user = NULL;

        sprintf(t_buff, "You are logged out");
        write(client, t_buff, strlen(t_buff));
    }
}

static User *create_account(int client)
{
    User user = {0};
    user.name = malloc(MAX_USERNAME_SIZE + 1);
    user.password = malloc(MAX_USERNAME_SIZE + 1);

    while (true) {
        sprintf(t_buff, "\nname: \n");
        write(client, t_buff, strlen(t_buff));
        read_from_socket(client, r_buff);
        trim_suffix(r_buff, strlen(r_buff));

        if (!get_user_by_name(r_buff)) {
            strcpy(user.name, r_buff);
            break;
        }

        sprintf(t_buff, "Name is taken\n");
        write(client, t_buff, strlen(t_buff));
    }

    sprintf(t_buff, "\npassword: \n");
    write(client, t_buff, strlen(t_buff));
    read_from_socket(client, r_buff);
    trim_suffix(r_buff, strlen(r_buff));
    strcpy(user.password, r_buff);

    user.logged_in = true;
    users[user_count++] = user;

    printf("[INFO] created new user '%s'\n", user.name);

    sprintf(t_buff, "Account was created successfully!\nYou are now logged in as '%s'", user.name);
    write(client, t_buff, strlen(t_buff));

    return &users[user_count - 1];
}

static User *log_in(int client)
{
    User *user = NULL;

    while (true) {
        sprintf(t_buff, "\nname: \n");
        write(client, t_buff, strlen(t_buff));
        read_from_socket(client, r_buff);
        trim_suffix(r_buff, strlen(r_buff));

        user = get_user_by_name(r_buff);
        if (user) {
            break;
        }

        sprintf(t_buff, "Could not find user\n");
        write(client, t_buff, strlen(t_buff));
    }

    while (true) {
        sprintf(t_buff, "\npassword: \n");
        write(client, t_buff, strlen(t_buff));
        read_from_socket(client, r_buff);
        trim_suffix(r_buff, strlen(r_buff));

        if (strcmp(r_buff, user->password) == 0) {
            user->logged_in = true;
            sprintf(t_buff, "You are now logged in as '%s'", user->name);
            return user;
        }

        sprintf(t_buff, "Password is incorrect!\n");
        write(client, t_buff, strlen(t_buff));
    }
}

const char *commands = "\n"
    "---------------------------------------------------\n"
    "/commands       - List all existing commands\n"
    "/create-account - Create new user account\n"
    "/login          - Login in to existing user account\n"
    "/logout         - Login in to existing user account\n"
    "---------------------------------------------------\n";

static bool print_client_message(int client, User *user)
{
    memset(r_buff, 0, MAX_MSG_SIZE);

    int bytes_read = read(client, r_buff, MAX_MSG_SIZE);
    if (bytes_read < 0) {
        perror("ERROR: read failed");
        return false;
    }
    if (bytes_read == 0) {
        printf("Client closed connection abnormaly\n");
        return false;
    }

    trim_suffix(r_buff, bytes_read);

    if (strcmp(r_buff, "/quit") == 0) {
        write(client, STATUS_QUIT, strlen(STATUS_QUIT));
        printf("Client closed connection via command: '%s'\n", r_buff);
        return false;
    }

    if (strcmp(r_buff, "/commands") == 0) {
        write(client, commands, strlen(commands));
    } else if (strcmp(r_buff, "/create-account") == 0) {
        if (!user) {
            user = create_account(client);
        } else {
        }
    } else if (strcmp(r_buff, "/login") == 0) {
        if (!user) {
            user = log_in(client);
        } else {
            sprintf(t_buff, "You are already logged in as '%s'", user->name);
            write(client, t_buff, strlen(t_buff));
        }
    } else if (strcmp(r_buff, "/logout") == 0) {
        log_out(client, user);
    }

    printf("[Client] %s\n", r_buff);

    write(client, STATUS_OK, strlen(STATUS_OK));

    return true;
}

static size_t id;

static void *handle_connection(void *arg)
{
    User *user = NULL;
    int sock = *(int *)arg;

    while (true) {
        int client = accept(sock, 0, 0);
        if (client < 0) {
            perror("ERROR: accept failed");
            return NULL;
        }

        printf("Connection established with client\n");

        const char *message = "Connection established ('/commands' for info)\n";
        write(client, message, strlen(message));

        while (true) {
            if (!print_client_message(client, user)) break;
        }

        if (close(client) < 0) {
            perror("ERROR: client close failed\n");
            return NULL;
        }
    }

    if (close(sock) < 0) {
        perror("ERROR: server close failed\n");
        return NULL;
    }
}

